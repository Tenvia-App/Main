<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark window background so there is no white flash at launch (and dark pixels save power on OLED screens). -->
    <style name="Theme.Tenvia" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/night</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <color name="night">#FF101B17</color>
</resources>
